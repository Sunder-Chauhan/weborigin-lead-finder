# Optional: Supabase persistence/auth (not wired into the current demo screen yet).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional self-hosted SearXNG public-web search. Leave empty to disable it.
# The instance must allow JSON format (search.formats includes json). Example: http://localhost:8080/
SEARXNG_BASE_URL=

# Optional Tomba fallback credentials for local development only.
# Provider lookup is disabled by default and cannot run unless the flag below is true.
# Phone enrichment may consume credits. Keep these keys server-side.
ENABLE_TOMBA_FALLBACK=false
TOMBA_API_KEY=
TOMBA_API_SECRET=
