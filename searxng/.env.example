# Copy this file to .env and replace the secret with a random value before starting.
# PowerShell: ( -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | ForEach-Object {[char]$_}) )
# Or use OpenSSL: openssl rand -hex 32
SEARXNG_SECRET=replace_this_with_a_random_secret_before_running
SEARXNG_PORT=8080
SEARXNG_VERSION=latest
